const { createServer } = require("http");
const { randomBytes, createHash } = require("crypto");
const open = require("open");
const CLIENT_ID = "a2dbb5fe-fcbc-4c79-a93f-e8e01d84cfe7";
const AUTHORITY = "https://login.microsoftonline.com/common";
const REDIRECT_URI = "http://localhost:8765/auth";
const SCOPES = "XboxLive.signin XboxLive.offline_access";
let server = null;
let verifier = "";
let state = "";
async function startLogin() {
  console.log("[NOVA AUTH] auth service started");
  verifier = Buffer.from(randomBytes(32)).toString("base64").replace(/\+/g, "-").replace(/\//g, "_").replace(/=/g, "");
  const challenge = Buffer.from(createHash("sha256").update(verifier).digest()).toString("base64").replace(/\+/g, "-").replace(/\//g, "_").replace(/=/g, "");
  state = Buffer.from(randomBytes(16)).toString("base64").replace(/\+/g, "-").replace(/\//g, "_").replace(/=/g, "");
  const url = AUTHORITY + "/oauth2/v2.0/authorize?client_id=" + CLIENT_ID + "&response_type=code&redirect_uri=" + encodeURIComponent(REDIRECT_URI) + "&scope=" + encodeURIComponent(SCOPES) + "&state=" + state + "&code_challenge=" + challenge + "&code_challenge_method=S256";
  console.log("[NOVA AUTH] authorization URL created");
  server = require("http").createServer((req, res) => {
    const u = new URL(req.url || "/", "http://localhost:8765");
    if (u.pathname === "/auth") {
      const code = u.searchParams.get("code");
      const err = u.searchParams.get("error");
      const returnedState = u.searchParams.get("state");
      if (err) {
        res.end("Error: " + err);
        server?.close();
        console.log("[NOVA AUTH] Microsoft auth error:", err);
        return { status: "MICROSOFT_AUTH_FAILED", error: err };
      }
      if (returnedState !== state) {
        res.end("Invalid state");
        server?.close();
        console.log("[NOVA AUTH] invalid state");
        return { status: "INVALID_CALLBACK_STATE" };
      }
      res.end("Login received. You may close this window.");
      server?.close();
      console.log("[NOVA AUTH] callback received, code present:", !!code);
      return { status: "callback_received", code };
    }
    res.end("Not found");
  }).listen(8765, "127.0.0.1", () => console.log("[NOVA AUTH] callback server listening on 127.0.0.1:8765"));
  console.log("[NOVA AUTH] browser launch attempted");
  await open(url);
  console.log("[NOVA AUTH] browser launched");
  return { status: "login_started", url };
}
module.exports = { startLogin };